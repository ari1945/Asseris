# W10 deploy — template variabel untuk docker-compose.yml (server + Postgres).
# SALIN ke `.env` di folder yang sama, lalu isi nilainya. `.env` di-IGNORE git (lihat .gitignore);
# `.env.example` ini AMAN di-commit (tanpa rahasia nyata).
#
#   cp .env.example .env        # lalu edit
#   docker compose up --build   # compose otomatis memuat .env di sebelahnya
#
# Generate APP_ENCRYPTION_KEY (32-byte hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- WAJIB ---
# Password Postgres (dipakai db service + DATABASE_URL server). Untuk validasi lokal bebas;
# untuk prod pakai rahasia kuat.
POSTGRES_PASSWORD=changeme

# Kunci enkripsi totpSecret-at-rest (AES-256-GCM). 32-byte hex/base64. Kosong = TOTP tak terenkripsi.
APP_ENCRYPTION_KEY=
APP_SIGNING_KEY=

# File checkpoint hash-chain pada mount off-box (EFS/NFS/object-storage sidecar), bukan volume DB.
AUDIT_CHECKPOINT_PATH=/var/lib/asseris-audit-checkpoint/checkpoint.json
AUDIT_OUTBOX_STALL_SECONDS=60

# Stage 6 — penyimpanan lampiran bukti audit. Default = inline (blob AES-256-GCM di kolom DB).
# Set ATTACHMENT_STORAGE=s3 untuk memindahkan byte ke object store S3-compatible (AWS S3 / MinIO /
# Cloudflare R2). S3_BUCKET wajib; S3_ENDPOINT + S3_FORCE_PATH_STYLE=1 untuk MinIO/R2; kredensial
# lewat env atau default credential chain (EC2 instance profile). Lihat docs/SPIKE-S3-STORAGE.md.
ATTACHMENT_STORAGE=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0

# --- OPSIONAL ---
# Set 1 HANYA bila server berada di belakang TLS (cookie auth jadi Secure). Lokal/HTTP: biarkan 0.
COOKIE_SECURE=0

# CSV IP/CIDR yang boleh login (allowlist admin). Kosong = nonaktif.
ADMIN_IP_ALLOWLIST=

# HANYA socket peer pada CSV IP/CIDR ini yang boleh memasok X-Forwarded-For.
# Contoh Docker private network: 172.16.0.0/12. Kosong = abaikan semua forwarding header.
TRUSTED_PROXY_CIDRS=

# Proxy narasi LLM (W8). Kosong = fitur "Jelaskan temuan" graceful-off.
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
